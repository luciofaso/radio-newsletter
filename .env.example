# Episode language: en, it or fr (see LANGUAGES in main.py to add more)
EPISODE_LANGUAGE=en

# Gmail (IMAP, read-only)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FOLDER=Newsletter

# LLM (Claude). Model IDs are listed in the Anthropic documentation
ANTHROPIC_API_KEY=
MODEL_SELECTION=claude-haiku-5-5
MODEL_SCRIPT=claude-sonnet-5-5

# Voice (Gemini-TTS on Google Cloud)
# API key bound to a service account with the Agent Platform User role (see README.md)
GOOGLE_API_KEY=
# Google Cloud project number
GOOGLE_CLOUD_PROJECT=
TTS_MODEL=gemini-2.5-pro-tts
TTS_VOICE=Charon

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Random, unguessable prefix, e.g. the output of: python3 -c "import secrets;print(secrets.token_urlsafe(16))"
R2_SECRET_PREFIX=
